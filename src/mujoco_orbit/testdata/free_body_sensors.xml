<mujoco model="free_body_sensors">
  <size nuser_sensor="4"/>
  <option timestep="0.01" gravity="0 0 0"/>

  <worldbody>
    <body name="spacecraft" pos="0 0 0">
      <freejoint/>
      <geom type="box" size="0.5 0.5 0.5" mass="100" rgba="0.3 0.5 0.9 1"/>

      <site name="imu" pos="0 0 0" quat="1 0 0 0"/>
      <site name="sun_head" pos="0 0 0.2" quat="1 0 0 0"/>
      <site name="tracker" pos="0.2 0 0" quat="1 0 0 0"/>
      <site name="mag_rotated" pos="0 0.2 0" quat="0.7071067811865476 0 0 0.7071067811865476"/>
    </body>
  </worldbody>

  <sensor>
    <gyro name="gyro_body" site="imu" noise="5e-4" user="2e-5 0 0 0"/>
    <accelerometer name="acc_body" site="imu" noise="2e-3"/>
    <magnetometer name="mag_body" site="imu" noise="1e-7"/>
    <magnetometer name="mag_rotated" site="mag_rotated" noise="1e-7"/>

    <user
      name="orbit_sun_body"
      objtype="site"
      objname="sun_head"
      datatype="axis"
      needstage="pos"
      dim="3"
      noise="8.726646259971648e-4"
    />
    <user
      name="orbit_horizon_body"
      objtype="site"
      objname="sun_head"
      datatype="axis"
      needstage="pos"
      dim="3"
      noise="1.7453292519943296e-3"
    />
    <user
      name="orbit_star_body"
      objtype="site"
      objname="tracker"
      datatype="axis"
      needstage="pos"
      dim="3"
      noise="2.42406840554768e-5"
      user="0.3 0.8 -0.4 0"
    />
  </sensor>
</mujoco>
