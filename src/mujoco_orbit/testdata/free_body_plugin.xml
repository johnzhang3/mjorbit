<mujoco model="free_body_plugin">
  <!-- Phase 1 scaffold smoke test: a free body whose only MuJoCo-visible
       extension is the mujoco_orbit.orbit plugin. If this model loads, the
       plugin .so was found, registered, and named correctly. -->
  <option timestep="0.01" gravity="0 0 0"/>

  <extension>
    <plugin plugin="mujoco_orbit.orbit"/>
  </extension>

  <worldbody>
    <body name="spacecraft" pos="0 0 0">
      <freejoint/>
      <geom type="box" size="0.5 0.5 0.5" mass="100" rgba="0.3 0.5 0.9 1"/>
      <plugin plugin="mujoco_orbit.orbit">
        <config key="use_j2" value="true"/>
      </plugin>
    </body>
  </worldbody>
</mujoco>
