<mujoco model="free_body">
  <!-- Minimal free rigid body for Phase 0 / Phase 3 smoke tests.
       Gravity is disabled at runtime by compile_cpu (opt.gravity = 0).
       The orbit layer provides all inertial forces via xfrc_applied. -->
  <option timestep="0.01" gravity="0 0 0"/>

  <worldbody>
    <body name="spacecraft" pos="0 0 0">
      <freejoint/>
      <geom type="box" size="0.5 0.5 0.5" mass="100" rgba="0.3 0.5 0.9 1"/>
    </body>
  </worldbody>
</mujoco>
