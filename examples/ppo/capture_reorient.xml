<mujoco model="capture_reorient">
  <!--
    The teaser/banner bi-manual free-flyer (gold MLI bus, radiators, nadir dish,
    three-panel solar wings, two 2-link arms on the +X/-X faces reaching toward
    +Z) captures a FREE-FLOATING client satellite by its grapple bar and slews
    the captured stack so the client's antenna points at nadir.

    Spacecraft actuation is mjorbit's native actuator models (the mjorbit element below):
    3 body-axis reaction wheels (torque- and speed-limited, momentum stored in
    the wheels) and 6 RCS thrusters (+/-X, +/-Y, +/-Z through the bus origin,
    unidirectional, force-limited). The arm joints are position servos. Each
    hand is the truss example's two-jaw clamp (mirrored so the jaws point
    inboard, away from the elbow-out forearm): a fixed lower jaw plus an upper
    jaw on a slide joint (`grip_*`) that closes onto the bar; a wrist hinge
    (`wrist_*`) is auto-driven by the env to keep the jaws level with the bus.

    The client is an independent free body. Nothing rigidly connects it to the
    servicer (no weld, no equality): the closed jaws hold the bar by contact +
    friction only. Collision is restricted to the servicer's forearms + jaws
    (contype/conaffinity 2/4) vs the client's bar and body (4/2); all pairs are
    capsule-vs-box primitives that MJWarp supports directly. Everything else
    (bus, panels, detail geoms) is non-colliding.

    Frames follow the mjorbit convention: MuJoCo world is the chief-centered
    local inertial frame with axes parallel to ECI; the orbit overlay applies
    differential gravity, gravity gradient and drag through xfrc_applied, so
    MuJoCo gravity stays off. Units: m, kg, N.
  -->
  <compiler angle="radian"/>
  <option timestep="0.01" gravity="0 0 0" integrator="implicitfast">
    <flag contact="enable"/>
  </option>

  <default>
    <joint damping="0.5" armature="0.01"/>
    <geom rgba="0.6 0.6 0.6 1" contype="0" conaffinity="0"/>
    <default class="detail">
      <geom contype="0" conaffinity="0" mass="0.01"/>
    </default>
    <default class="arm_act">
      <position kp="80" kv="14" forcerange="-40 40"/>
    </default>
    <default class="panel_hinge">
      <joint type="hinge" axis="1 0 0" range="-0.05 3.2"
             stiffness="2.0" damping="0.3" springref="0"/>
    </default>
    <default class="panel_cell">
      <geom type="box" size="0.25 0.4 0.005" mass="2"
            contype="0" conaffinity="0" rgba="0.10 0.14 0.38 1"/>
    </default>
    <default class="panel_frame">
      <geom type="box" size="0.27 0.42 0.002" mass="0.01"
            contype="0" conaffinity="0" rgba="0.74 0.76 0.80 1"/>
    </default>
    <!-- Servicer grasp surfaces: forearms + capsule jaws (2/4). -->
    <default class="hand">
      <geom contype="2" conaffinity="4" condim="3"
            friction="2.6 0.1 0.002" solref="0.006 1" solimp="0.98 0.999 0.001"
            rgba="0.85 0.86 0.88 1"/>
    </default>
    <!-- Client collision geoms (4/2). -->
    <default class="client_col">
      <geom contype="4" conaffinity="2" condim="3"
            friction="2.6 0.1 0.002" solref="0.006 1" solimp="0.98 0.999 0.001"/>
    </default>
  </default>

  <worldbody>
    <!-- ======================= Servicer (teaser bus) ======================= -->
    <body name="bus" pos="0 0 0">
      <freejoint name="base"/>
      <geom name="bus" type="box" size="0.5 0.3 0.3" mass="300"
            rgba="0.82 0.64 0.22 1"/>
      <geom name="radiator_top" class="detail" type="box" size="0.40 0.24 0.012"
            pos="0 0 0.312" rgba="0.93 0.94 0.96 1"/>
      <geom name="radiator_bot" class="detail" type="box" size="0.40 0.24 0.012"
            pos="0 0 -0.312" rgba="0.93 0.94 0.96 1"/>
      <geom name="star_tracker" class="detail" type="cylinder" size="0.05 0.07"
            pos="0.30 0 0.36" zaxis="0.3 0 1" rgba="0.15 0.15 0.18 1"/>
      <geom name="antenna_boom" class="detail" type="cylinder" size="0.02 0.09"
            pos="0.15 0 -0.40" zaxis="0 0 1" rgba="0.65 0.67 0.70 1"/>
      <geom name="antenna_dish" class="detail" type="cylinder" size="0.20 0.015"
            pos="0.15 0 -0.50" zaxis="0 0 1" rgba="0.88 0.89 0.92 1"/>
      <geom name="antenna_feed" class="detail" type="sphere" size="0.035"
            pos="0.15 0 -0.56" rgba="0.95 0.62 0.15 1"/>
      <geom name="nozzle_main" class="detail" type="cylinder" size="0.08 0.06"
            pos="-0.55 0 -0.20" zaxis="1 0 0" rgba="0.25 0.25 0.28 1"/>
      <geom name="nozzle_rcs_p" class="detail" type="cylinder" size="0.035 0.04"
            pos="-0.53 0.22 -0.22" zaxis="1 0 0" rgba="0.30 0.30 0.33 1"/>
      <geom name="nozzle_rcs_n" class="detail" type="cylinder" size="0.035 0.04"
            pos="-0.53 -0.22 -0.22" zaxis="1 0 0" rgba="0.30 0.30 0.33 1"/>

      <!-- ============ Arm A (+X face) ============ -->
      <body name="link1_a" pos="0.5 0 0">
        <joint name="shoulder_a" type="hinge" axis="0 1 0" range="-3.14 3.14"/>
        <geom name="shoulder_housing_a" class="detail" type="cylinder"
              size="0.06 0.05" zaxis="0 1 0" rgba="0.30 0.31 0.34 1"/>
        <geom name="upper_a" type="capsule" fromto="0 0 0 0.8 0 0" size="0.04"
              mass="5" rgba="0.85 0.86 0.88 1"/>
        <body name="link2_a" pos="0.8 0 0">
          <joint name="elbow_a" type="hinge" axis="0 1 0" range="-3.14 3.14"/>
          <geom name="elbow_housing_a" class="detail" type="cylinder"
                size="0.05 0.045" zaxis="0 1 0" rgba="0.30 0.31 0.34 1"/>
          <geom name="fore_a" class="hand" type="capsule" fromto="0 0 0 0.6 0 0"
                size="0.035" mass="3"/>
          <body name="ee_a" pos="0.6 0 0">
            <joint name="wrist_a" type="hinge" axis="0 1 0" range="-3.14 3.14"/>
            <geom name="palm_a" class="detail" type="box" size="0.03 0.05 0.11"
                  pos="-0.01 0 0" rgba="0.95 0.65 0.10 1"/>
            <geom name="lowjaw_a" class="hand" type="capsule"
                  fromto="-0.02 0 -0.09 -0.22 0 -0.09" size="0.03" mass="0.4"/>
            <body name="jaw_a" pos="0 0 0">
              <joint name="grip_a" type="slide" axis="0 0 1" range="-0.03 0.12"/>
              <geom name="upjaw_a" class="hand" type="capsule"
                    fromto="-0.02 0 0.10 -0.22 0 0.10" size="0.03" mass="0.4"/>
            </body>
          </body>
        </body>
      </body>

      <!-- ============ Arm B (-X face, mirrored) ============ -->
      <body name="link1_b" pos="-0.5 0 0">
        <joint name="shoulder_b" type="hinge" axis="0 1 0" range="-3.14 3.14"/>
        <geom name="shoulder_housing_b" class="detail" type="cylinder"
              size="0.06 0.05" zaxis="0 1 0" rgba="0.30 0.31 0.34 1"/>
        <geom name="upper_b" type="capsule" fromto="0 0 0 -0.8 0 0" size="0.04"
              mass="5" rgba="0.85 0.86 0.88 1"/>
        <body name="link2_b" pos="-0.8 0 0">
          <joint name="elbow_b" type="hinge" axis="0 1 0" range="-3.14 3.14"/>
          <geom name="elbow_housing_b" class="detail" type="cylinder"
                size="0.05 0.045" zaxis="0 1 0" rgba="0.30 0.31 0.34 1"/>
          <geom name="fore_b" class="hand" type="capsule" fromto="0 0 0 -0.6 0 0"
                size="0.035" mass="3"/>
          <body name="ee_b" pos="-0.6 0 0">
            <joint name="wrist_b" type="hinge" axis="0 1 0" range="-3.14 3.14"/>
            <geom name="palm_b" class="detail" type="box" size="0.03 0.05 0.11"
                  pos="0.01 0 0" rgba="0.95 0.35 0.50 1"/>
            <geom name="lowjaw_b" class="hand" type="capsule"
                  fromto="0.02 0 -0.09 0.22 0 -0.09" size="0.03" mass="0.4"/>
            <body name="jaw_b" pos="0 0 0">
              <joint name="grip_b" type="slide" axis="0 0 1" range="-0.03 0.12"/>
              <geom name="upjaw_b" class="hand" type="capsule"
                    fromto="0.02 0 0.10 0.22 0 0.10" size="0.03" mass="0.4"/>
            </body>
          </body>
        </body>
      </body>

      <!-- ============ +Y solar wing: 3 framed panels ============ -->
      <body name="wp_0" pos="0 0.3 0.16">
        <joint name="hp_0" class="panel_hinge"/>
        <geom name="hinge_p_0" class="detail" type="cylinder" size="0.015 0.06"
              zaxis="1 0 0" rgba="0.80 0.66 0.30 1"/>
        <geom name="panel_p_0" pos="0 0.4 0" class="panel_cell"/>
        <geom name="frame_p_0" pos="0 0.4 -0.006" class="panel_frame"/>
        <body name="wp_1" pos="0 0.8 0">
          <joint name="hp_1" class="panel_hinge"/>
          <geom name="hinge_p_1" class="detail" type="cylinder" size="0.015 0.06"
                zaxis="1 0 0" rgba="0.80 0.66 0.30 1"/>
          <geom name="panel_p_1" pos="0 0.4 0" class="panel_cell"/>
          <geom name="frame_p_1" pos="0 0.4 -0.006" class="panel_frame"/>
          <body name="wp_2" pos="0 0.8 0">
            <joint name="hp_2" class="panel_hinge"/>
            <geom name="hinge_p_2" class="detail" type="cylinder" size="0.015 0.06"
                  zaxis="1 0 0" rgba="0.80 0.66 0.30 1"/>
            <geom name="panel_p_2" pos="0 0.4 0" class="panel_cell"/>
            <geom name="frame_p_2" pos="0 0.4 -0.006" class="panel_frame"/>
          </body>
        </body>
      </body>

      <!-- ============ -Y solar wing: 3 framed panels (mirrored) ============ -->
      <body name="wn_0" pos="0 -0.3 0.16">
        <joint name="hn_0" class="panel_hinge"/>
        <geom name="hinge_n_0" class="detail" type="cylinder" size="0.015 0.06"
              zaxis="1 0 0" rgba="0.80 0.66 0.30 1"/>
        <geom name="panel_n_0" pos="0 -0.4 0" class="panel_cell"/>
        <geom name="frame_n_0" pos="0 -0.4 -0.006" class="panel_frame"/>
        <body name="wn_1" pos="0 -0.8 0">
          <joint name="hn_1" class="panel_hinge"/>
          <geom name="hinge_n_1" class="detail" type="cylinder" size="0.015 0.06"
                zaxis="1 0 0" rgba="0.80 0.66 0.30 1"/>
          <geom name="panel_n_1" pos="0 -0.4 0" class="panel_cell"/>
          <geom name="frame_n_1" pos="0 -0.4 -0.006" class="panel_frame"/>
          <body name="wn_2" pos="0 -0.8 0">
            <joint name="hn_2" class="panel_hinge"/>
            <geom name="hinge_n_2" class="detail" type="cylinder" size="0.015 0.06"
                  zaxis="1 0 0" rgba="0.80 0.66 0.30 1"/>
            <geom name="panel_n_2" pos="0 -0.4 0" class="panel_cell"/>
            <geom name="frame_n_2" pos="0 -0.4 -0.006" class="panel_frame"/>
          </body>
        </body>
      </body>
    </body>

    <!-- ===================== Client satellite (free body) ====================
         Body frame origin = grapple-bar center; bar along client +X. The client
         box sits on two posts on the bar's +Z side, and its high-gain antenna
         looks out along client +Z: that boresight is what the servicer must
         point at nadir. ~50 kg, so the captured stack is noticeably harder to
         slew than the bare bus. The 0.84 m bar ends just inboard of the wrists in
         the hold pose; each hand clamps it between its post and its end. -->
    <body name="client" pos="0 0 1.0">
      <freejoint name="client_free"/>
      <geom name="bar" class="client_col" type="box" size="0.42 0.07 0.07" mass="5"
            rgba="0.78 0.58 0.22 1"/>
      <geom name="bar_cap_p" class="detail" type="box" pos="0.42 0 0"
            size="0.015 0.09 0.09" rgba="0.62 0.46 0.20 1"/>
      <geom name="bar_cap_n" class="detail" type="box" pos="-0.42 0 0"
            size="0.015 0.09 0.09" rgba="0.62 0.46 0.20 1"/>
      <geom name="post_p" class="detail" type="box" pos="0.15 0 0.195"
            size="0.04 0.04 0.125" mass="1" rgba="0.55 0.56 0.6 1"/>
      <geom name="post_n" class="detail" type="box" pos="-0.15 0 0.195"
            size="0.04 0.04 0.125" mass="1" rgba="0.55 0.56 0.6 1"/>
      <geom name="client_body" class="client_col" type="box" pos="0 0 0.62"
            size="0.4 0.4 0.3" mass="40" rgba="0.80 0.81 0.84 1"/>
      <geom name="client_mli" class="detail" type="box" pos="0 0 0.62"
            size="0.405 0.36 0.26" rgba="0.70 0.55 0.20 1"/>
      <geom name="client_dish_boom" class="detail" type="cylinder" pos="0 0 0.97"
            size="0.025 0.05" rgba="0.65 0.67 0.70 1"/>
      <geom name="client_dish" class="detail" type="cylinder" pos="0 0 1.03"
            size="0.28 0.015" rgba="0.92 0.93 0.95 1"/>
      <geom name="client_feed" class="detail" type="sphere" pos="0 0 1.10"
            size="0.04" rgba="0.95 0.62 0.15 1"/>
      <geom name="client_wing_p" class="detail" type="box" pos="0 0.85 0.62"
            size="0.3 0.45 0.008" mass="1" rgba="0.10 0.14 0.38 1"/>
      <geom name="client_wing_n" class="detail" type="box" pos="0 -0.85 0.62"
            size="0.3 0.45 0.008" mass="1" rgba="0.10 0.14 0.38 1"/>
    </body>
  </worldbody>

  <actuator>
    <position name="shoulder_a_pos" class="arm_act" joint="shoulder_a" ctrlrange="-3.14 3.14"/>
    <position name="elbow_a_pos" class="arm_act" joint="elbow_a" ctrlrange="-3.14 3.14"/>
    <position name="shoulder_b_pos" class="arm_act" joint="shoulder_b" ctrlrange="-3.14 3.14"/>
    <position name="elbow_b_pos" class="arm_act" joint="elbow_b" ctrlrange="-3.14 3.14"/>
    <position name="wrist_a_pos" class="arm_act" joint="wrist_a" ctrlrange="-3.14 3.14"/>
    <position name="wrist_b_pos" class="arm_act" joint="wrist_b" ctrlrange="-3.14 3.14"/>
    <position name="grip_a_pos" joint="grip_a" kp="900" kv="40" forcerange="-300 300"
              ctrlrange="-0.03 0.12"/>
    <position name="grip_b_pos" joint="grip_b" kp="900" kv="40" forcerange="-300 300"
              ctrlrange="-0.03 0.12"/>
  </actuator>

  <!-- Spacecraft actuators (mjorbit native models). Wheels: 0.1 kg*m^2 rotors,
       5 N*m torque, 150 rad/s -> 15 N*m*s of storable momentum per axis (sized
       so a 180 deg slew of the ~450 kg captured stack fits in under a minute).
       Thrusters: 25 N each, ordered [+x, +y, +z, -x, -y, -z] (body frame). -->
  <mjorbit use_j2="true" use_drag="true" use_srp="false" use_magnetic="false"
           use_gravity_gradient="true">
    <reaction_wheel name="rw_x" body="bus" axis="1 0 0" inertia="0.1"
                    speed_limit="150" torque_limit="5"/>
    <reaction_wheel name="rw_y" body="bus" axis="0 1 0" inertia="0.1"
                    speed_limit="150" torque_limit="5"/>
    <reaction_wheel name="rw_z" body="bus" axis="0 0 1" inertia="0.1"
                    speed_limit="150" torque_limit="5"/>
    <thruster name="thr_xp" body="bus" pos="0 0 0" dir="1 0 0" force_limit="25"/>
    <thruster name="thr_yp" body="bus" pos="0 0 0" dir="0 1 0" force_limit="25"/>
    <thruster name="thr_zp" body="bus" pos="0 0 0" dir="0 0 1" force_limit="25"/>
    <thruster name="thr_xn" body="bus" pos="0 0 0" dir="-1 0 0" force_limit="25"/>
    <thruster name="thr_yn" body="bus" pos="0 0 0" dir="0 -1 0" force_limit="25"/>
    <thruster name="thr_zn" body="bus" pos="0 0 0" dir="0 0 -1" force_limit="25"/>
  </mjorbit>
</mujoco>
