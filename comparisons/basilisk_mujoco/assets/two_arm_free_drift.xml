      </body>

      <body name="arm_2" pos="0.55 -0.28 0">
        <joint name="hinge_2" type="hinge" axis="0 1 0"/>
        <inertial pos="0.35 0 0" mass="8" diaginertia="0.04 0.42 0.42"/>
        <geom type="box" pos="0.35 0 0" size="0.35 0.025 0.05" mass="0"
              rgba="0.16 0.72 0.34 1"/>
