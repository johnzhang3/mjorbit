<mujoco model="hinged_satellite">
  <compiler angle="radian"/>
  <option timestep="0.01" gravity="0 0 0">
    <flag contact="disable"/>
  </option>

  <default>
    <joint damping="0.08" armature="0.002" limited="true"/>
    <geom rgba="0.65 0.67 0.70 1"/>
  </default>

  <worldbody>
    <body name="hub" pos="0 0 0">
      <freejoint name="hub_free"/>
      <inertial pos="0 0 0" mass="120" diaginertia="8 10 12"/>
      <geom type="box" size="0.45 0.35 0.25" mass="0" rgba="0.28 0.48 0.85 1"/>

      <body name="panel_1" pos="0.55 0 0">
        <joint name="hinge_1" type="hinge" axis="0 1 0" range="-1.57079632679 1.57079632679"/>
        <inertial pos="0.3 0 0" mass="8" diaginertia="0.05 0.35 0.35"/>
        <geom type="box" pos="0.3 0 0" size="0.3 0.02 0.15" mass="0"
              rgba="0.1 0.65 0.55 1"/>

        <body name="panel_2" pos="0.6 0 0">
          <joint name="hinge_2" type="hinge" axis="0 1 0"
                 range="-1.57079632679 1.57079632679"/>
          <inertial pos="0.25 0 0" mass="6" diaginertia="0.04 0.22 0.22"/>
          <geom type="box" pos="0.25 0 0" size="0.25 0.018 0.13" mass="0"
                rgba="0.16 0.72 0.34 1"/>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <position name="hinge_1_pos" joint="hinge_1" kp="12" ctrlrange="-1.57079632679 1.57079632679"/>
    <position name="hinge_2_pos" joint="hinge_2" kp="10" ctrlrange="-1.57079632679 1.57079632679"/>
  </actuator>
</mujoco>

