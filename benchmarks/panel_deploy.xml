<mujoco model="panel_deploy">
  <!-- Solar-panel deployment benchmark scenario.

       A bus carries two symmetric wings (+X and -X), each with six hinge-
       jointed solar panels daisy-chained at their far ends. Every hinge is a
       passive torsional spring with damping and a hard range stop at the
       deployed angle, so the wings deploy from their initial folded angle
       toward flat (qpos = 0) and latch.

       Panels collide with each other (contype/conaffinity = 2) but not with
       the bus (contype/conaffinity = 1). This keeps the partially-folded
       initial config penetration-free while still exercising panel-panel
       contact during the swing.

       No MuJoCo actuators — dynamics are entirely passive multibody plus
       (with the orbit overlay) ECI gravity, GG torque, drag, etc.

       Used by benchmarks/panel_deploy.py. -->

  <compiler angle="radian"/>
  <option timestep="0.005" gravity="0 0 0">
    <flag contact="enable"/>
  </option>

  <size njmax="200" nconmax="200"/>

  <default>
    <joint armature="0.005" damping="0.05"/>
    <geom condim="3" friction="0.5 0.005 0.0001"
          solref="0.005 1" solimp="0.9 0.95 0.001"/>
    <default class="panel_hinge">
      <joint type="hinge" axis="0 1 0" range="-0.05 3.2"
             stiffness="2.5" damping="0.4" springref="0"/>
    </default>
    <default class="panel_geom">
      <geom type="box" size="0.4 0.25 0.005" mass="3"
            contype="2" conaffinity="2" rgba="0.2 0.2 0.5 1"/>
    </default>
  </default>

  <worldbody>
    <body name="bus" pos="0 0 0">
      <freejoint name="base"/>
      <geom name="bus" type="box" size="0.5 0.4 0.15" mass="300"
            contype="1" conaffinity="1" rgba="0.3 0.5 0.9 1"/>

      <!-- ============ +X wing: 6 panels ============ -->
      <body name="wp_0" pos="0.5 0 0.16">
        <joint name="hp_0" class="panel_hinge"/>
        <geom name="panel_p_0" pos="0.4 0 0" class="panel_geom"/>
        <body name="wp_1" pos="0.8 0 0">
          <joint name="hp_1" class="panel_hinge"/>
          <geom name="panel_p_1" pos="0.4 0 0" class="panel_geom"/>
          <body name="wp_2" pos="0.8 0 0">
            <joint name="hp_2" class="panel_hinge"/>
            <geom name="panel_p_2" pos="0.4 0 0" class="panel_geom"/>
            <body name="wp_3" pos="0.8 0 0">
              <joint name="hp_3" class="panel_hinge"/>
              <geom name="panel_p_3" pos="0.4 0 0" class="panel_geom"/>
              <body name="wp_4" pos="0.8 0 0">
                <joint name="hp_4" class="panel_hinge"/>
                <geom name="panel_p_4" pos="0.4 0 0" class="panel_geom"/>
                <body name="wp_5" pos="0.8 0 0">
                  <joint name="hp_5" class="panel_hinge"/>
                  <geom name="panel_p_5" pos="0.4 0 0" class="panel_geom"/>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>

      <!-- ============ -X wing: 6 panels (mirrored along X) ============ -->
      <body name="wn_0" pos="-0.5 0 0.16">
        <joint name="hn_0" class="panel_hinge"/>
        <geom name="panel_n_0" pos="-0.4 0 0" class="panel_geom"/>
        <body name="wn_1" pos="-0.8 0 0">
          <joint name="hn_1" class="panel_hinge"/>
          <geom name="panel_n_1" pos="-0.4 0 0" class="panel_geom"/>
          <body name="wn_2" pos="-0.8 0 0">
            <joint name="hn_2" class="panel_hinge"/>
            <geom name="panel_n_2" pos="-0.4 0 0" class="panel_geom"/>
            <body name="wn_3" pos="-0.8 0 0">
              <joint name="hn_3" class="panel_hinge"/>
              <geom name="panel_n_3" pos="-0.4 0 0" class="panel_geom"/>
              <body name="wn_4" pos="-0.8 0 0">
                <joint name="hn_4" class="panel_hinge"/>
                <geom name="panel_n_4" pos="-0.4 0 0" class="panel_geom"/>
                <body name="wn_5" pos="-0.8 0 0">
                  <joint name="hn_5" class="panel_hinge"/>
                  <geom name="panel_n_5" pos="-0.4 0 0" class="panel_geom"/>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>
</mujoco>
